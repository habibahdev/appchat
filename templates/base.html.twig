<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Messagerie{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}{% endblock %}
</head>
<body>

{% if app.user %}
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="{{ path('app_conversation_index') }}">
                <i class="bi bi-chat-dots-fill text-primary"></i> Messagerie
            </a>

            <div class="d-flex align-items-center gap-3 ms-auto">
                {% include 'partials/_notifications.html.twig' %}

                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                             style="width: 32px; height: 32px;">
                            {{ app.user.userIdentifier|slice(0, 1)|upper }}
                        </div>
                        <span class="d-none d-md-inline">{{ app.user.userIdentifier }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
{% endif %}

<main>
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% block body %}{% endblock %}
</main>


{% if app.user %}
    <script type="module">
        import MessagingClient from '{{ asset('assets/js/messaging.js') }}';

        window.currentUserId = {{ app.user.id }};

        // client global : pas de conversationId, juste notifications + présence
        window.globalMessagingClient = new MessagingClient({
            mercureUrl: '{{ mercure_public_url }}',
        });

        window.globalMessagingClient.onNotification = (notif) => {
            window.dispatchEvent(new CustomEvent('mercure-notification', { detail: notif }));
        };

        window.globalMessagingClient.onPresenceChange = (data) => {
            document.querySelectorAll(`[data-conversation-id] [data-user-status]`).forEach((dot) => {
                // à affiner : lier data-conversation-id à l'userId du correspondant côté back si besoin
            });
        };

        window.globalMessagingClient.init();
    </script>
{% endif %}


</body>
</html>
