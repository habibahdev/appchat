{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block body %}
<div class="container-fluid vh-100 p-0">
    <div class="row g-0 h-100">
        <div class="col-12 col-md-4 col-lg-3 border-end bg-light">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Discussions</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newConversationModal">
                    <i class="bi bi-plus-lg"></i> Nouveau
                </button>
            </div>

            <div class="list-group list-group-flush overflow-auto" style="max-height: calc(100vh - 70px);">
                {% for conversation in conversations %}
                    <a href="{{ path('app_conversation_show', { id: conversation.id }) }}"
                       class="list-group-item list-group-item-action d-flex align-items-start gap-2 py-3"
                       data-conversation-id="{{ conversation.id }}">
                        <div class="position-relative">
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                 style="width: 45px; height: 45px;">
                                {{ conversation.name ? conversation.name|slice(0, 1)|upper : '?' }}
                            </div>
                            <span class="presence-dot position-absolute bottom-0 end-0 rounded-circle border border-white bg-secondary"
                                  style="width: 12px; height: 12px;"
                                  data-user-status></span>
                        </div>

                        <div class="flex-grow-1 overflow-hidden">
                            <div class="d-flex justify-content-between">
                                <strong class="text-truncate">{{ conversation.name ?? 'Conversation' }}</strong>
                                {% if conversation.lastMessageAt %}
                                    <small class="text-muted flex-shrink-0">
                                        {{ conversation.lastMessageAt|date('H:i') }}
                                    </small>
                                {% endif %}
                            </div>
                            <div class="d-flex justify-content-between">
                                <small class="text-muted text-truncate">
                                    {{ conversation.lastMessage ?? 'Aucun message' }}
                                </small>
                                {% if conversation.unreadCount > 0 %}
                                    <span class="badge bg-primary rounded-pill flex-shrink-0">
                                        {{ conversation.unreadCount }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="p-4 text-center text-muted">
                        Aucune conversation pour l'instant.
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="col-12 col-md-8 col-lg-9 d-none d-md-flex align-items-center justify-content-center text-muted">
            Sélectionne une conversation pour commencer.
        </div>
    </div>
</div>
{% endblock %}